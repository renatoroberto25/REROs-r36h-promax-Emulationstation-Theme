<?xml version="1.0" encoding="UTF-8"?>
<!-- RENATO // NEON — EmulationStation / ArkOS, 4:3 -->
<theme>
  <formatVersion>7</formatVersion>
  <variables>
    <accent>B6FF43</accent>
    <purple>9A62FF</purple>
    <text>F2EBFF</text>
    <muted>A99ABE</muted>
    <titleFont>./_inc/fonts/Rajdhani-Bold.ttf</titleFont>
    <bodyFont>./_inc/fonts/Cabin-Bold.ttf</bodyFont>
  </variables>

  <view name="system,basic,detailed,video">
    <image name="background" extra="true">
      <pos>0 0</pos>
      <size>1 1</size>
      <path>./_inc/neon/basic-bg.png</path>
      <zIndex>0</zIndex>
    </image>
    <text name="brand" extra="true">
      <pos>0.052 0.042</pos>
      <size>0.58 0.065</size>
      <text>RENATO // NEON</text>
      <fontPath>${titleFont}</fontPath>
      <fontSize>0.052</fontSize>
      <color>${accent}</color>
      <zIndex>10</zIndex>
    </text>
    <text name="tagline" extra="true">
      <pos>0.054 0.108</pos>
      <size>0.62 0.03</size>
      <text>RETROGAMES / MODO CYBERPUNK</text>
      <fontPath>${titleFont}</fontPath>
      <fontSize>0.023</fontSize>
      <color>${muted}</color>
      <zIndex>10</zIndex>
    </text>
    <helpsystem name="help">
      <pos>0.052 0.945</pos>
      <origin>0 0</origin>
      <fontPath>${titleFont}</fontPath>
      <fontSize>0.025</fontSize>
      <textColor>${text}</textColor>
      <iconColor>${accent}</iconColor>
    </helpsystem>
  </view>

  <view name="system">
    <image name="background">
      <path>./_inc/neon/system-bg.png</path>
    </image>
    <text name="section" extra="true">
      <pos>0.052 0.225</pos>
      <size>0.8 0.045</size>
      <text>01 / ESCOLHA SEU SISTEMA</text>
      <fontPath>${titleFont}</fontPath>
      <fontSize>0.031</fontSize>
      <color>${purple}</color>
    </text>
    <carousel name="systemcarousel">
      <type>horizontal</type>
      <pos>0.155 0.39</pos>
      <size>0.69 0.23</size>
      <color>00000000</color>
      <logoSize>0.49 0.15</logoSize>
      <logoScale>1</logoScale>
      <maxLogoCount>1</maxLogoCount>
      <logoAlignment>center</logoAlignment>
      <defaultTransition>slide</defaultTransition>
      <scrollSound>./_inc/sounds/select_shorter.wav</scrollSound>
      <zIndex>40</zIndex>
    </carousel>
    <image name="logo">
      <path>./_inc/neon/logos/${system.theme}.svg</path>
      <color>${accent}</color>
    </image>
    <text name="logoText">
      <fontPath>${titleFont}</fontPath>
      <fontSize>0.065</fontSize>
      <color>${accent}</color>
      <forceUppercase>true</forceUppercase>
    </text>
    <text name="system-name" extra="true">
      <pos>0.10 0.7</pos>
      <size>0.80 0.055</size>
      <text>${system.fullName}</text>
      <fontPath>${titleFont}</fontPath>
      <fontSize>0.036</fontSize>
      <forceUppercase>true</forceUppercase>
      <alignment>center</alignment>
      <color>${text}</color>
    </text>
    <text name="systemInfo">
      <pos>0.10 0.78</pos>
      <size>0.80 0.04</size>
      <fontPath>${titleFont}</fontPath>
      <fontSize>0.027</fontSize>
      <alignment>center</alignment>
      <color>${muted}</color>
      <backgroundColor>00000000</backgroundColor>
    </text>
  </view>

  <view name="basic,detailed,video">
    <text name="section" extra="true">
      <pos>0.052 0.205</pos>
      <size>0.88 0.042</size>
      <text>02 / ${system.fullName}</text>
      <fontPath>${titleFont}</fontPath>
      <fontSize>0.031</fontSize>
      <forceUppercase>true</forceUppercase>
      <color>${purple}</color>
    </text>
    <image name="logo,md_thumbnail,md_marquee">
      <visible>false</visible>
    </image>
    <text name="logoText,md_name,md_lbl_rating,md_lbl_releasedate,md_lbl_developer,md_lbl_publisher,md_lbl_genre,md_lbl_players,md_lbl_lastplayed,md_lbl_playcount,md_developer,md_publisher,md_genre,md_players,md_playcount">
      <visible>false</visible>
    </text>
    <datetime name="md_lastplayed,md_releasedate">
      <visible>false</visible>
    </datetime>
    <rating name="md_rating">
      <visible>false</visible>
    </rating>
    <textlist name="gamelist">
      <pos>0.052 0.28</pos>
      <size>0.885 0.568</size>
      <fontPath>${bodyFont}</fontPath>
      <fontSize>0.034</fontSize>
      <primaryColor>${text}</primaryColor>
      <secondaryColor>${purple}</secondaryColor>
      <selectedColor>10081D</selectedColor>
      <selectorColor>${accent}</selectorColor>
      <selectorHeight>0.052</selectorHeight>
      <selectorOffsetY>0</selectorOffsetY>
      <alignment>left</alignment>
      <horizontalMargin>0.012</horizontalMargin>
      <lineSpacing>1.65</lineSpacing>
      <scrollSound>./_inc/sounds/select_shorter.wav</scrollSound>
      <zIndex>20</zIndex>
    </textlist>
  </view>

  <view name="detailed,video">
    <image name="background">
      <path>./_inc/neon/gamelist-bg.png</path>
    </image>
    <textlist name="gamelist">
      <size>0.40 0.568</size>
      <fontSize>0.032</fontSize>
      <lineSpacing>1.75</lineSpacing>
    </textlist>
    <image name="md_image">
      <pos>0.731 0.442</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.403 0.326</maxSize>
      <default>./_inc/neon/no-media.png</default>
      <visible>true</visible>
      <zIndex>30</zIndex>
    </image>
    <text name="md_name">
      <pos>0.525 0.648</pos>
      <size>0.411 0.055</size>
      <fontPath>${titleFont}</fontPath>
      <fontSize>0.034</fontSize>
      <color>${accent}</color>
      <forceUppercase>true</forceUppercase>
      <visible>true</visible>
    </text>
    <text name="md_description">
      <pos>0.525 0.718</pos>
      <size>0.411 0.14</size>
      <fontPath>${bodyFont}</fontPath>
      <fontSize>0.025</fontSize>
      <color>${muted}</color>
      <lineSpacing>1.25</lineSpacing>
      <visible>true</visible>
    </text>
  </view>

  <view name="video">
    <video name="md_video">
      <pos>0.731 0.442</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.403 0.326</maxSize>
      <delay>0.7</delay>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>true</showSnapshotDelay>
      <snapshotSource>image</snapshotSource>
      <zIndex>31</zIndex>
    </video>
  </view>

  <view name="menu">
    <menuBackground name="menubg">
      <color>2B1943</color>
      <centerColor>1B102D</centerColor>
    </menuBackground>
    <menuText name="menutext,menutitle,menufooter">
      <fontPath>${titleFont}</fontPath>
      <fontSize>0.034</fontSize>
      <color>${text}</color>
      <separatorColor>493260</separatorColor>
      <selectorColor>${accent}</selectorColor>
      <selectedColor>10081D</selectedColor>
    </menuText>
    <menuText name="menutitle">
      <color>${accent}</color>
    </menuText>
    <menuTextSmall name="menutextsmall">
      <fontPath>${bodyFont}</fontPath>
      <fontSize>0.025</fontSize>
      <color>${muted}</color>
    </menuTextSmall>
  </view>

  <view name="screen">
    <text name="clock">
      <pos>0.71 0.056</pos>
      <size>0.13 0.04</size>
      <fontPath>${titleFont}</fontPath>
      <fontSize>0.028</fontSize>
      <alignment>right</alignment>
      <color>${text}</color>
    </text>
    <batteryIndicator name="batteryIndicator">
      <pos>0.87 0.057</pos>
      <size>0.075 0.032</size>
      <color>${accent}</color>
      <itemSpacing>0.008</itemSpacing>
      <full>./_inc/images/battery/battery-100.svg</full>
      <at75>./_inc/images/battery/battery-75.svg</at75>
      <at50>./_inc/images/battery/battery-50.svg</at50>
      <at25>./_inc/images/battery/battery-25.svg</at25>
      <empty>./_inc/images/battery/battery-0.svg</empty>
      <incharge>./_inc/images/battery/battery-charging.svg</incharge>
      <networkIcon>./_inc/images/wifi.svg</networkIcon>
    </batteryIndicator>
  </view>
</theme>
